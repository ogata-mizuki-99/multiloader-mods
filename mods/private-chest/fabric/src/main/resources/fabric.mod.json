    "issues": "https://github.com/ogata-mizuki-99/multiloader-mods/issues"
  },
  "license": "All Rights Reserved",
  "icon": "assets/privatechest/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ogatamizuki.privatechest.fabric.PrivateChestModFabric"
    ],
    "client": [
      "com.ogatamizuki.privatechest.fabric.PrivateChestModFabricClient"
    ],
    "modmenu": [
