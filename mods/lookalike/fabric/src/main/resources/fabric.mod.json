{
  "schemaVersion": 1,
  "id": "lookalike",
  "version": "${version}",
  "name": "Lookalike",
  "description": "Temporarily disguise player skins, nametags, and shadows using a spyglass scan.\n\n望遠鏡で他プレイヤーのスキンをスキャンし、見た目（スキン・頭上ネームタグ）や影を動的に偽装するMOD。",
  "authors": [
    "OgataMizuki@Vtuber"
  ],
  "contact": {
    "homepage": "https://github.com/ogata-mizuki-99/multiloader-mods",
    "sources": "https://github.com/ogata-mizuki-99/multiloader-mods",
    "issues": "https://github.com/ogata-mizuki-99/multiloader-mods/issues"
  },
  "license": "MIT",
  "icon": "assets/lookalike/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ogatamizuki.lookalike.fabric.LookalikeModFabric"
    ],
    "client": [
      "com.ogatamizuki.lookalike.fabric.LookalikeModFabricClient"
    ],
    "modmenu": [
      "com.ogatamizuki.lookalike.fabric.LookalikeModMenuEntrypoint"
    ]
  },
  "mixins": [
    "lookalike.mixins.json",
    "lookalike.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=26.2"
  }
