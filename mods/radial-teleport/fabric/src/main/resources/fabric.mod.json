  "description": "Hold right-click with the Teleport Compass to open a radial menu. Jump to world spawn or online players — no operator permissions required. Guide Lib integration for in-game manual (optional).\n\nテレポートコンパス長押しでピザ型 UI を表示。ワールドスポーンやオンラインプレイヤーへ移動できます（OP 不要）。Guide Lib 連携でゲーム内マニュアル対応（任意）。",
  "authors": [
    "OgataMizuki@Vtuber"
  ],
  "contact": {
    "homepage": "https://github.com/ogata-mizuki-99/multiloader-mods",
    "sources": "https://github.com/ogata-mizuki-99/multiloader-mods",
    "issues": "https://github.com/ogata-mizuki-99/multiloader-mods/issues"
  },
  "license": "All Rights Reserved",
  "icon": "assets/radial_teleport/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ogatamizuki.radialteleport.fabric.RadialTeleportModFabric"
    ],
    "client": [
      "com.ogatamizuki.radialteleport.fabric.RadialTeleportModFabricClient"
    ],
    "modmenu": [
      "com.ogatamizuki.radialteleport.fabric.RadialTeleportModMenuEntrypoint"
    ]
  },
  "mixins": [
    "radial_teleport.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=26.2"
  }
